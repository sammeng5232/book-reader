# Build output. dist/ ships as a zip on GitHub Releases instead: Qt6WebEngineCore.dll
# alone exceeds GitHub's 100 MB per-file limit. build/ is PyInstaller's scratch space.
build/
dist/
*.spec.bak
__pycache__/
*.py[cod]

# Scratch
_scratch/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# The DjVu decoder is compiled from djvutool\*.cs on demand (djvu.tool_path()) and by
# build_exe.ps1; the binary is never committed.
assets/djvutool.exe
djvutool/*.exe
*.building.exe
